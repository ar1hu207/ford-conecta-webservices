# ===== App =====
NODE_ENV=development
PORT=3000

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=ford
DB_PASSWORD=ford_secret
DB_NAME=ford_conecta

# ===== JWT =====
# Obrigatório, mínimo de 32 caracteres (a API não sobe sem ele).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-change-me-please-use-a-long-random-secret
# Validade do access token, em segundos
JWT_EXPIRES_IN=3600
JWT_ISSUER=ford-conecta-api
JWT_AUDIENCE=ford-conecta-clients

# ===== CORS (origens autorizadas, separadas por vírgula) =====
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ===== Rate limiting =====
# Global: requisições por janela (ms), por IP
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Login e cadastro (anti força bruta)
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5

# ===== Testes e2e =====
# Banco separado, recriado a cada execução de npm run test:e2e
DB_NAME_TEST=ford_conecta_test
